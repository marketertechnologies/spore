{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "spore coordinator token-monitor",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "spore worker token-monitor",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "spore fleet replenish-hook",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "[ \"$SPORE_ROLE\" = engineer ] || exit 0; spore hooks 2>&1 | grep -q engineer-check || exit 0; exec spore hooks engineer-check",
            "timeout": 3600,
            "type": "command"
          },
          {
            "asyncRewake": true,
            "command": "spore hooks watch-inbox",
            "timeout": 604800,
            "type": "command"
          }
        ]
      }
    ]
  }
}

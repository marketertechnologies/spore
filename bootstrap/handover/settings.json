{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore hooks notify-coordinator",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/spore/.claude/hooks/block-bg-bash.pl",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore hooks pretooluse",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/spore/.claude/hooks/load-state-md.pl",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore coordinator token-monitor",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore worker token-monitor",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore fleet replenish-hook",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$SPORE_ROLE\" = engineer ] || exit 0; /run/current-system/sw/bin/spore hooks 2>&1 | grep -q engineer-check || exit 0; exec /run/current-system/sw/bin/spore hooks engineer-check",
            "timeout": 3600
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore hooks watch-inbox",
            "timeout": 604800,
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "SendMessage",
      "Read(~/.config/spore/**/secrets.env)",
      "Read(~/.config/spore/**/*.pem)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)"
    ]
  },
  "skipDangerousModePermissionPrompt": true
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "/usr/bin/notify-coordinator",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/lint-noise write",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/watch-inbox",
            "type": "command"
          },
          {
            "command": "/usr/bin/replenish",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "SendMessage",
      "Read(~/.config/spore/**/secrets.env)",
      "Read(~/.config/spore/**/*.pem)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Bash(*.claude/.credentials.json*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Edit(//**/.git)",
      "Edit(//**/.git/**)",
      "Edit(//**/*.git/hooks/**)",
      "Edit(//**/*.git/config)",
      "Edit(//**/.envrc)",
      "Edit(//**/.mcp.json)",
      "Edit(//**/.claude/settings*.json)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_login)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.zlogin)",
      "Edit(~/.tmux.conf)",
      "Edit(~/.config/tmux/**)",
      "Edit(~/.config/direnv/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(~/.config/systemd/user/**)",
      "Edit(~/.config/environment.d/**)",
      "Edit(~/.huskyrc)",
      "Edit(~/.config/husky/**)",
      "Edit(~/.local/bin/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/spore/**)"
    ]
  }
}
